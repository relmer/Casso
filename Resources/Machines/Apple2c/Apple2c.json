// DO NOT EDIT. This file is a Casso embedded default and will be
// overwritten on launch when an out-of-date stamp is detected.
// To customize, copy it to Machines/<Name>/<Name>.json (any name
// other than the embedded defaults) and edit that copy.
{
    "$cassoMachineVersion": 3,

    // The //c shipped with the green-phosphor Monitor //c, so green is what
    // this machine looks like out of the box. Stated here rather than left to
    // the shared UI defaults because it is a fact about THIS machine; the
    // shared table's "color" is the right answer for a ][ or an //e with a
    // color monitor and the wrong one here.
    //
    // A user override still wins: the per-machine store keeps only what
    // differs from this baseline, so choosing white on a //c saves "white"
    // and choosing green saves nothing at all.
    "$cassoUiPrefs": {
        "colorMode": "green"
    },

    "name": "Apple //c",
    "releaseYear": 1984,
    "cpu": "65C02",
    "cpuManufacturer": "Rockwell",
    "timing": {
        "videoStandard": "ntsc",
        "clockSpeed": 1022727,
        "cyclesPerScanline": 65
    },
    "ram": [
        { "address": "0x0000", "size": "0xC000" },
        { "address": "0x0000", "size": "0xC000", "bank": "aux" }
    ],
    "systemRom": {
        "address": "0xC000",
        "file": "Apple2c.rom",
        "romBankSize": "0x4000",
        "romBankSelect": "0xC028"
    },
    "characterRom": {
        "file": "Apple2c_Video.rom"
    },
    "internalDevices": [
        { "type": "apple2e-keyboard" },
        { "type": "apple2-speaker" },
        { "type": "apple2e-softswitches" },
        { "type": "apple2e-mmu" },
        { "type": "language-card" }
    ],
    // The //c has no slots. Its peripherals are built in and its expansion is
    // a row of connectors on the back panel, so its ports belong to the
    // machine rather than to a card. These are named, not numbered: a disk
    // port and a joystick port are not interchangeable the way a Disk ][
    // card's two drive connectors are.
    //
    // An empty `device` is a connector with nothing on it -- a real state and
    // the //c's shipping one. The INTERNAL drive is soldered in rather than
    // attached, so it is not a port and deliberately does not appear here.
    "ports": [
        { "name": "disk",     "device": "" },
        { "name": "serial1",  "device": "" },
        { "name": "serial2",  "device": "" },
        { "name": "joystick", "device": "" }
    ],
    "video": {
        "modes": ["apple2-text40", "apple2-text80", "apple2-lores", "apple2-hires", "apple2-doublehires"]
    },
    "keyboard": {
        "type": "apple2e-full"
    }
}

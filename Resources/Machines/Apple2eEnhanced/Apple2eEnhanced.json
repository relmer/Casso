// DO NOT EDIT. This file is a Casso embedded default and will be
// overwritten on launch when an out-of-date stamp is detected.
// To customize, copy it to Machines/<Name>/<Name>.json (any name
// other than the embedded defaults) and edit that copy.
{
    "$cassoMachineVersion": 11,
    "name": "Apple //e Enhanced",
    "releaseYear": 1985,
    "timing": {
        "videoStandard": "ntsc",
        "clockSpeed": 1020484,
        "cyclesPerScanline": 65
    },
    "systemRom": {
        "address": "0xC000",
        "file": "Apple2eEnhanced.rom"
    },
    "characterRom": {
        "file": "Apple2eEnhanced_Video.rom"
    },
    "slots": [
        { "slot": 1, "device": "parallel-printer", "capabilityFlag": "optional" },
        { "slot": 2, "device": "super-serial-card", "firmware": "SSC.rom", "enabled": false },
        { "slot": 3, "device": "uthernet2", "capabilityFlag": "optional", "enabled": false },
        { "slot": 4, "device": "mockingboard-c" },
        // The Disk ][ Interface has two drive connectors whether or not both
        // are used, so the card always declares two ports. An empty string
        // detaches that drive without changing the card.
        { "slot": 6, "device": "disk-ii", "rom": "Disk2.rom",
          "ports": ["disk-ii-drive", "disk-ii-drive"] },
        // The Apple II SCSI Card's ports are SCSI IDs 0-6. The HD20SC at ID 6
        // has the stock image, an empty 32 MB ProDOS volume, which the card's
        // ROM passes over so the floppy in slot 6 still boots.
        { "slot": 7, "device": "apple-scsi-card", "rom": "341-0437-A.rom",
          "ports": [ "", "", "", "", "", "", { "device": "hd20sc", "image": "stock" } ] }
    ]
}

//
//  The casso-rocks demo's sources and image payloads, compiled into the test
//  assembly.
//
//  A UNIT TEST MAY NOT READ THE FILESYSTEM, and this test used to read all
//  nine of these off the repo at run time -- and, for a while, write one back.
//  Embedding them moves the read to BUILD time, where reading files is the
//  whole job, and leaves the test with nothing to open.
//
//  THE FILES ARE NAMED HERE, NOT COPIED. The resource compiler reads whatever
//  is at these paths when the test assembly is built, so the bytes under test
//  are always the bytes in the repo. A generated byte-array header would be a
//  second copy that drifts from the first, which is the failure this is
//  supposed to prevent rather than reproduce.
//

#include "DemoAssets.h"

IDR_DEMO_STAGE1_SRC   RCDATA "..\\..\\Apple2\\Demos\\casso-rocks.a65"
IDR_DEMO_STAGE2_SRC   RCDATA "..\\..\\Apple2\\Demos\\casso-rocks-stage2.a65"
IDR_DEMO_HGR          RCDATA "..\\..\\Apple2\\Demos\\cassowary.hgr"
IDR_DEMO_BANDS        RCDATA "..\\..\\Apple2\\Demos\\test-bands.hgr"
IDR_DEMO_LORES        RCDATA "..\\..\\Apple2\\Demos\\lores-bars.lores"
IDR_DEMO_DHGR_AUX     RCDATA "..\\..\\Apple2\\Demos\\dhgr-cassowary-aux.bin"
IDR_DEMO_DHGR_MAIN    RCDATA "..\\..\\Apple2\\Demos\\dhgr-cassowary-main.bin"

IDR_DEMO_DHGR_MONO_AUX   RCDATA "..\\..\\Apple2\\Demos\\dhgr-cassowary-mono-aux.bin"
IDR_DEMO_DHGR_MONO_MAIN  RCDATA "..\\..\\Apple2\\Demos\\dhgr-cassowary-mono-main.bin"

IDR_BASIC_CORPUS_SRC  RCDATA "..\\Fixtures\\Basic\\construct-corpus.bas"
IDR_BASIC_CORPUS_TOK  RCDATA "..\\Fixtures\\Basic\\construct-corpus.tok"

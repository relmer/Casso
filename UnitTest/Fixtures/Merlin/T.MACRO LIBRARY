*-------------------------
*      Macro library
*-------------------------

CH = $24
PRNTAX = $F941
TABV = $FB5B
COUT = $FDED

INCD MAC
 INC ]1
 BNE NC
 INC ]1+1
NC
 <<<

DECD MAC
 LDA ]1
 BNE NC
 DEC ]1+1
NC DEC ]1
 <<<

MOV MAC
 LDA ]1
 STA ]2
 <<<

MOVD MAC
 MOV ]1;]2
 IF (=]1 ;Syntax MOVD (ADR1),Y;????
 INY
 IF (=]2 ; MOVD (ADR1),Y;(ADR2),Y
 MOV ]1;]2
 ELSE ; MOVD (ADR1),Y;ADR2
 MOV ]1;]2+1
 FIN
 ELSE
 IF (=]2 ;Syntax MOVD ????;(ADR2),Y
 INY
 IF #=]1 ; MOVD #ADR1;(ADR2),Y
 MOV ]1/$100;]2
 ELSE ; MOVD ADR1;(ADR2),Y
 MOV ]1+1;]2
 FIN
 ELSE ;Syntax MOVD ????;ADR2
 IF #=]1 ; MOVD #ADR1;ADR2
 MOV ]1/$100;]2+1
 ELSE ; MOVD ADR1;ADR2
 MOV ]1+1;]2+1
 FIN
 FIN
 FIN
 <<<

LDHI MAC ;For calls from other macs
 IF #=]1
 LDA ]1/$100
 ELSE
 LDA ]1+1
 FIN
 <<<

ADD MAC
 CLC
 LDA ]1
 ADC ]2
 STA ]3
 LDHI ]1
 IF #=]2
 ADC ]2/$100
 ELSE
 ADC ]2+1
 FIN
 STA ]3+1
 <<<

SUB MAC
 SEC
 LDA ]1
 SBC ]2
 STA ]3
 LDHI ]1
 IF #=]2
 SBC ]2/$100
 ELSE
 SBC ]2+1
 FIN
 STA ]3+1
 <<<

ADDX MAC
 TXA
ADDA MAC
 CLC
 ADC ]1
 STA ]2
 LDHI ]1
 ADC #0
 STA ]2+1
 <<<

ADDY MAC
 TYA
 ADDA ]1;]2
 <<<

ADDNUM MAC
 LDA #]1
 CLC
 ADC ]2
 STA ]2
 BCC NC
 INC ]2+1
NC
 <<<

SWAP MAC
 LDA ]1
 PHA
 LDA ]2
 STA ]1
 PLA
 STA ]2
 <<<

COMPARE MAC
 LDA ]1
 CMP ]2
 LDHI ]1
 SBC ]2+1
 <<<

POKE MAC
 MOV #]2;]1
 <<<

STADR MAC
 POKE ]2;#]1
 POKE ]2+1;#>]1
 <<<

PRCHR MAC
 LDA #]1
 JSR COUT
 <<<

PRADRS MAC
 LDX ]1
 LDA ]1+1
 JSR PRNTAX
 <<<

GOTOXY MAC
 POKE CH;]1
 LDA #]2
 JSR TABV
 <<<

PRINT MAC ;Expects SENDMSG PUT file
 JSR SENDMSG
 IF ]1=" ;Syntax PRINT "message"
 ASC ]1
 ELSE ;Syntax PRINT 8D87;"message"
 HEX ]1
 ASC ]2
 FIN
 BRK
 <<<

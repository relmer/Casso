<?xml version="1.0" encoding="utf-8"?>

<!--
  Template. scripts/BuildMsix.ps1 substitutes {VERSION} and {ARCHITECTURE}.
  No comment here may contain a double hyphen; makepri rejects the manifest.
-->

<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
    xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
    xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
    xmlns:desktop2="http://schemas.microsoft.com/appx/manifest/desktop/windows10/2"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap uap2 uap3 desktop desktop2 rescap">

    <!--
      Publisher must match the signing certificate's subject exactly. Windows
      builds the package family name out of Name and Publisher, so changing
      either one installs a second copy instead of upgrading the first.
    -->
    <Identity
        Name="relmer.Casso"
        Publisher="CN=Robert Elmer, O=Robert Elmer, L=Redmond, S=Washington, C=US"
        Version="{VERSION}"
        ProcessorArchitecture="{ARCHITECTURE}" />

    <!--
      Every logo path here points at a file that does not exist. Assets holds
      the scale-qualified variants, and the resource index BuildMsix.ps1
      generates with makepri maps the plain name to the right one.
    -->
    <Properties>
        <DisplayName>Casso</DisplayName>
        <PublisherDisplayName>Robert Elmer</PublisherDisplayName>
        <Logo>Assets\StoreLogo.png</Logo>
    </Properties>

    <!-- 1809 is the floor for app execution aliases, not for the emulator. -->
    <Dependencies>
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
    </Dependencies>

    <Resources>
        <Resource Language="en-US" />
    </Resources>

    <Capabilities>
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>

    <Applications>

        <Application Id="Casso" Executable="Casso.exe" EntryPoint="Windows.FullTrustApplication">

            <!-- BackgroundColor is the badge's plate color. Windows 10 tiles only. -->
            <uap:VisualElements
                DisplayName="Casso"
                Description="An Apple II family emulator with a built-in, fully AS65-compatible assembler."
                BackgroundColor="#121016"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png">
                <uap:DefaultTile
                    ShortName="Casso"
                    Square71x71Logo="Assets\Square71x71Logo.png"
                    Square310x310Logo="Assets\Square310x310Logo.png"
                    Wide310x150Logo="Assets\Wide310x150Logo.png" />
            </uap:VisualElements>

            <Extensions>
                <!-- The disk image types, each a separate type with the text
                     Casso Explorer's Type column has for it, and the disk icon File
                     Explorer draws for them; the extensions and names match
                     FileAssociations::kExtensions and
                     CatalogModel::GetDiskImageTypeName. A package declares each
                     type for one application only, so Casso Explorer is
                     reached by the second command, which Casso passes on. -->
                <uap3:Extension Category="windows.fileTypeAssociation">
                    <uap3:FileTypeAssociation Name="appleiidskimage" Parameters="--disk1 &quot;%1&quot;">
                        <uap:DisplayName>Apple II disk image</uap:DisplayName>
                        <uap:Logo>Assets\DiskImageLogo.png</uap:Logo>
                        <uap:SupportedFileTypes>
                            <uap:FileType>.dsk</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap2:SupportedVerbs>
                            <uap3:Verb Id="open" Parameters="--disk1 &quot;%1&quot;">Open</uap3:Verb>
                            <uap3:Verb Id="explore" Parameters="--explore &quot;%1&quot;">Open in Casso Explorer</uap3:Verb>
                        </uap2:SupportedVerbs>
                    </uap3:FileTypeAssociation>
                </uap3:Extension>

                <uap3:Extension Category="windows.fileTypeAssociation">
                    <uap3:FileTypeAssociation Name="appleiidoimage" Parameters="--disk1 &quot;%1&quot;">
                        <uap:DisplayName>DOS-order disk image</uap:DisplayName>
                        <uap:Logo>Assets\DiskImageLogo.png</uap:Logo>
                        <uap:SupportedFileTypes>
                            <uap:FileType>.do</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap2:SupportedVerbs>
                            <uap3:Verb Id="open" Parameters="--disk1 &quot;%1&quot;">Open</uap3:Verb>
                            <uap3:Verb Id="explore" Parameters="--explore &quot;%1&quot;">Open in Casso Explorer</uap3:Verb>
                        </uap2:SupportedVerbs>
                    </uap3:FileTypeAssociation>
                </uap3:Extension>

                <uap3:Extension Category="windows.fileTypeAssociation">
                    <uap3:FileTypeAssociation Name="appleiipoimage" Parameters="--disk1 &quot;%1&quot;">
                        <uap:DisplayName>ProDOS-order disk image</uap:DisplayName>
                        <uap:Logo>Assets\DiskImageLogo.png</uap:Logo>
                        <uap:SupportedFileTypes>
                            <uap:FileType>.po</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap2:SupportedVerbs>
                            <uap3:Verb Id="open" Parameters="--disk1 &quot;%1&quot;">Open</uap3:Verb>
                            <uap3:Verb Id="explore" Parameters="--explore &quot;%1&quot;">Open in Casso Explorer</uap3:Verb>
                        </uap2:SupportedVerbs>
                    </uap3:FileTypeAssociation>
                </uap3:Extension>

                <uap3:Extension Category="windows.fileTypeAssociation">
                    <uap3:FileTypeAssociation Name="appleiiwozimage" Parameters="--disk1 &quot;%1&quot;">
                        <uap:DisplayName>WOZ disk image</uap:DisplayName>
                        <uap:Logo>Assets\DiskImageLogo.png</uap:Logo>
                        <uap:SupportedFileTypes>
                            <uap:FileType>.woz</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap2:SupportedVerbs>
                            <uap3:Verb Id="open" Parameters="--disk1 &quot;%1&quot;">Open</uap3:Verb>
                            <uap3:Verb Id="explore" Parameters="--explore &quot;%1&quot;">Open in Casso Explorer</uap3:Verb>
                        </uap2:SupportedVerbs>
                    </uap3:FileTypeAssociation>
                </uap3:Extension>

                <uap3:Extension Category="windows.fileTypeAssociation">
                    <uap3:FileTypeAssociation Name="appleiinibimage" Parameters="--disk1 &quot;%1&quot;">
                        <uap:DisplayName>Nibble disk image</uap:DisplayName>
                        <uap:Logo>Assets\DiskImageLogo.png</uap:Logo>
                        <uap:SupportedFileTypes>
                            <uap:FileType>.nib</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap2:SupportedVerbs>
                            <uap3:Verb Id="open" Parameters="--disk1 &quot;%1&quot;">Open</uap3:Verb>
                            <uap3:Verb Id="explore" Parameters="--explore &quot;%1&quot;">Open in Casso Explorer</uap3:Verb>
                        </uap2:SupportedVerbs>
                    </uap3:FileTypeAssociation>
                </uap3:Extension>

                <uap3:Extension Category="windows.fileTypeAssociation">
                    <uap3:FileTypeAssociation Name="appleiinb2image" Parameters="--disk1 &quot;%1&quot;">
                        <uap:DisplayName>NB2 nibble disk image</uap:DisplayName>
                        <uap:Logo>Assets\DiskImageLogo.png</uap:Logo>
                        <uap:SupportedFileTypes>
                            <uap:FileType>.nb2</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap2:SupportedVerbs>
                            <uap3:Verb Id="open" Parameters="--disk1 &quot;%1&quot;">Open</uap3:Verb>
                            <uap3:Verb Id="explore" Parameters="--explore &quot;%1&quot;">Open in Casso Explorer</uap3:Verb>
                        </uap2:SupportedVerbs>
                    </uap3:FileTypeAssociation>
                </uap3:Extension>

                <!-- Makes `casso` work in a terminal. The .exe is required here. -->
                <uap3:Extension Category="windows.appExecutionAlias" Executable="Casso.exe" EntryPoint="Windows.FullTrustApplication">
                    <uap3:AppExecutionAlias>
                        <desktop:ExecutionAlias Alias="Casso.exe" />
                    </uap3:AppExecutionAlias>
                </uap3:Extension>
            </Extensions>

        </Application>

        <Application Id="CassoExplorer" Executable="CassoExplorer.exe" EntryPoint="Windows.FullTrustApplication">

            <!-- Its own tiles, built by GenerateMsixAssets.ps1 from its own
                 icon with -Prefix Explorer, so Start does not show Casso's
                 cassowary for both. -->
            <uap:VisualElements
                DisplayName="Casso Explorer"
                Description="An Apple II disk image explorer."
                BackgroundColor="#121016"
                Square150x150Logo="Assets\ExplorerSquare150x150Logo.png"
                Square44x44Logo="Assets\ExplorerSquare44x44Logo.png">

                <uap:DefaultTile
                    Square71x71Logo="Assets\ExplorerSquare71x71Logo.png"
                    Square310x310Logo="Assets\ExplorerSquare310x310Logo.png"
                    Wide310x150Logo="Assets\ExplorerWide310x150Logo.png" />

            </uap:VisualElements>

            <Extensions>
                <uap3:Extension Category="windows.appExecutionAlias" Executable="CassoExplorer.exe" EntryPoint="Windows.FullTrustApplication">
                    <uap3:AppExecutionAlias>
                        <desktop:ExecutionAlias Alias="CassoExplorer.exe" />
                    </uap3:AppExecutionAlias>
                </uap3:Extension>
            </Extensions>

        </Application>

        <Application Id="CassoCli" Executable="CassoCli.exe" EntryPoint="Windows.FullTrustApplication">

            <!-- AppListEntry: a command-line tool, so no Start item for it. -->
            <uap:VisualElements
                AppListEntry="none"
                DisplayName="Casso CLI"
                Description="Casso's command-line assembler, disk manager and headless 6502 runner."
                BackgroundColor="#121016"
                Square150x150Logo="Assets\Square150x150Logo.png"
                Square44x44Logo="Assets\Square44x44Logo.png" />

            <Extensions>
                <uap3:Extension Category="windows.appExecutionAlias" Executable="CassoCli.exe" EntryPoint="Windows.FullTrustApplication">
                    <uap3:AppExecutionAlias>
                        <desktop:ExecutionAlias Alias="CassoCli.exe" />
                    </uap3:AppExecutionAlias>
                </uap3:Extension>
            </Extensions>

        </Application>

    </Applications>

    <!--
      Inbound rules for the fixed ports only, each one protocol and one port
      rather than the whole program. Every profile, public included, since
      Windows calls a new network public: nothing binds these ports until the
      user turns on a network link, so a rule for an idle program admits
      nothing. Ports the user chooses, such as a port forward's, are admitted
      at run time instead.
    -->
    <Extensions>
        <desktop2:Extension Category="windows.firewallRules">
            <desktop2:FirewallRules Executable="CassoExplorer.exe">
                <!-- Announcements from Apples on the network. -->
                <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="all" LocalPortMin="6510" LocalPortMax="6510" />
                <!-- A Wi-Fi modem dialing in. -->
                <desktop2:Rule Direction="in" IPProtocol="TCP" Profile="all" LocalPortMin="6400" LocalPortMax="6400" />
            </desktop2:FirewallRules>
        </desktop2:Extension>
        <desktop2:Extension Category="windows.firewallRules">
            <desktop2:FirewallRules Executable="Casso.exe">
                <!-- The source port of the emulated Uthernet II's
                     announcements. The address translation drops a datagram
                     from a sender the guest has not sent to. -->
                <desktop2:Rule Direction="in" IPProtocol="UDP" Profile="all" LocalPortMin="6511" LocalPortMax="6511" />
            </desktop2:FirewallRules>
        </desktop2:Extension>
    </Extensions>

</Package>

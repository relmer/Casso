#include "resource.h"
#include <windows.h>
#include "Version.h"    // single source of truth for the app version

// Application icon. The lowest icon id in this module is the one Explorer
// shows for CassoExplorer.exe, and it is the only one.
IDI_CASSO_EXPLORER                  ICON "..\\Resources\\Icons\\CassoExplorer.ico"

// A disk image's icon in the tree, the list and the address bar.
IDI_DISK_IMAGE                      ICON "..\\Resources\\Icons\\Casso-disk-image.ico"

// An Applesoft BASIC file's icon inside a disk image.
IDI_APPLESOFT_FILE                  ICON "..\\Resources\\Icons\\Casso-applesoft.ico"
IDI_APPLE_MACHINE                   ICON "..\\Resources\\Icons\\Casso-apple-machine.ico"
IDI_APPLE_MACHINE_OFFLINE           ICON "..\\Resources\\Icons\\Casso-apple-machine-offline.ico"

// A partition's icon in the trees and lists, for dark and light surfaces.
IDI_PARTITION_DARK                  ICON "..\\Resources\\Icons\\Casso-partition-dark.ico"
IDI_PARTITION_LIGHT                 ICON "..\\Resources\\Icons\\Casso-partition-light.ico"

// The application's icon, which the About box shows beside what it is.
IDR_CASSO_EXPLORER_PICTURE_PNG      RCDATA "Assets\\CassoExplorer.png"

// The photograph itself, which heads the About box.
IDR_CASSO_EXPLORER_CASSOWARY_PNG    RCDATA "Assets\\Cassowary.png"

// The same machine configurations Casso embeds, extracted by
// AssetBootstrap::EnsureMachineConfigs so a disk image can be booted for its
// thumbnail, and its machine's ROMs offered, before Casso has ever run.
IDR_MACHINE_APPLE2      RCDATA "..\\Resources\\Machines\\Apple2\\Apple2.json"
IDR_MACHINE_APPLE2PLUS  RCDATA "..\\Resources\\Machines\\Apple2Plus\\Apple2Plus.json"
IDR_MACHINE_APPLE2E     RCDATA "..\\Resources\\Machines\\Apple2e\\Apple2e.json"
IDR_MACHINE_APPLE2C     RCDATA "..\\Resources\\Machines\\Apple2c\\Apple2c.json"
IDR_MACHINE_APPLE2C_PLUS RCDATA "..\\Resources\\Machines\\Apple2cPlus\\Apple2cPlus.json"
IDR_MACHINE_APPLE2E_ENHANCED RCDATA "..\\Resources\\Machines\\Apple2eEnhanced\\Apple2eEnhanced.json"

// The same built-in themes Casso embeds. AssetBootstrap::EnsureThemes compares
// the files on disk against the running module's embedded copies, so both
// programs must embed identical ones or each would rewrite the other's.
// Sources live under Resources/Themes/<Name>/.
IDR_THEME_SKEUO_THEME_JSON         RCDATA "..\\Resources\\Themes\\Skeuomorphic\\theme.json"

IDR_THEME_DARK_THEME_JSON          RCDATA "..\\Resources\\Themes\\DarkModern\\theme.json"

IDR_THEME_RETRO_THEME_JSON         RCDATA "..\\Resources\\Themes\\RetroTerminal\\theme.json"

IDR_THEME_PHOSPHOR_THEME_JSON      RCDATA "..\\Resources\\Themes\\Phosphor\\theme.json"
IDR_THEME_PHOSPHOR_FONT_TTF        RCDATA "..\\Resources\\Themes\\Phosphor\\fonts\\VT323-Regular.ttf"
IDR_THEME_PHOSPHOR_FONT_OFL        RCDATA "..\\Resources\\Themes\\Phosphor\\fonts\\OFL.txt"

// Version Information
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
    PRODUCTVERSION  VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "\0"
            VALUE "FileDescription",  "CassoExplorer Apple ][ Disk Image Browser\0"
            VALUE "FileVersion",      VERSION_STRING ".0\0"
            VALUE "InternalName",     "CassoExplorer\0"
            VALUE "OriginalFilename", "CassoExplorer.exe\0"
            VALUE "ProductName",      "Casso\0"
            VALUE "ProductVersion",   VERSION_STRING ".0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

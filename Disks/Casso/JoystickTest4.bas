10  HOME
20  VTAB 1: HTAB 6: PRINT "CASSO FOUR-AXIS JOYSTICK TEST"
30  VTAB 3: PRINT "PDL(0):"
40  VTAB 4: PRINT "PDL(1):"
50  VTAB 5: PRINT "PDL(2):"
60  VTAB 6: PRINT "PDL(3):"
70  VTAB 8: PRINT "BUTTON 0:"
80  VTAB 9: PRINT "BUTTON 1:"
90  VTAB 10: PRINT "BUTTON 2:"
95  VTAB 22: PRINT "CENTER READS 127.  CTRL-C TO STOP."
100 FOR P = 0 TO 3
110 X = PDL(P)
120 VTAB 3 + P: HTAB 9: PRINT X;"    ";
130 HTAB 14: GOSUB 400
140 NEXT P
200 VTAB 8: HTAB 11: A = PEEK(49249): GOSUB 300
210 VTAB 9: HTAB 11: A = PEEK(49250): GOSUB 300
220 VTAB 10: HTAB 11: A = PEEK(49251): GOSUB 300
230 GOTO 100
300 IF A > 127 THEN PRINT "PRESSED ";: RETURN
310 PRINT "UP      ";: RETURN
400 B = INT(X / 26): FOR I = 1 TO B: PRINT "*";: NEXT I
410 FOR I = B TO 9: PRINT " ";: NEXT I
420 RETURN

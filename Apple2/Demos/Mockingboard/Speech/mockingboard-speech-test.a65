; ============================================================================
;  mockingboard-speech-test.a65 -- minimal Mockingboard C speech smoke test
;
;  A single boot-sector program that UNCONDITIONALLY programs the slot-4
;  Mockingboard C's SSI 263A for a short phoneme sequence ("CASSO ROCKS"),
;  then repeats it forever. There is no card detection and no game logic: if you
;  hear the voice, the host speech path (decode -> chip -> synthesis ->
;  audio source -> mixer -> WASAPI) works end-to-end. Silence means the
;  fault is on the host side; its tone counterpart, mockingboard-test.a65,
;  isolates which half. The authored phoneme list below is the test's own
;  ground truth -- no external software or transcript is needed.
;
;  Boot: the slot-6 Disk2.rom firmware reads track 0 sector 0 into
;  $0800-$08FF and JMPs $0801 -- same contract casso-rocks.a65 relies on.
;
;  SSI 263A programming model (slot 4, chip socket 1 at $C440):
;    $C440  duration/phoneme   D7:6 = DR1,DR0    D5:0 = phoneme
;    $C441  inflection         I10-I3
;    $C442  rate/inflection    D7:4 = rate       D3 = I11, D2:0 = I2-I0
;    $C443  ctl/artic/amp      D7 = CTL          D6:4 = artic, D3:0 = amp
;    $C444  filter frequency   vocal-tract clock
;
;  The chip powers up with CTL set (Power Down). Loading the duration bits
;  and then driving CTL low latches the operating mode from them; DR=11
;  selects A/R active + phoneme timing + transitioned inflection, the mode
;  real speech drivers use. Each phoneme is then started by writing $C440.
;
;  Completion is COUNTED OUT here, not polled. The chip's A/R pin cannot be
;  read at $C440: the first 6522 decodes only A0-A3 and A7, so it answers all
;  across $C400-$C47F and $C440 is its port B. A read there returns that VIA,
;  and with RATE below writing $00 to $C442 -- which is also DDRB -- every
;  port B pin is an input and the read is a constant. A phoneme lasts
;  4096 * (16 - rate) * (4 - DR) chip ticks, and rate is fixed at 0 here, so
;  Hold counts (4 - DR) frames of 4096 * 16 ticks each.
; ============================================================================

    .org $0801

; -- Slot 4 SSI 263A registers (chip socket 1) -------------------------------
SPHON   = $C440            ; duration/phoneme
SINF    = $C441            ; inflection I10-I3
SRATE   = $C442            ; rate + I11, I2-I0
SCTL    = $C443            ; CTL + articulation + amplitude
SFILT   = $C444            ; vocal-tract filter clock

; -- Attribute values --------------------------------------------------------
MODEDR  = $C0              ; DR=11 in D7:6 -> A/R active, phoneme timing
CTLUP   = $80              ; CTL set: Power Down
CTLDN   = $5C              ; CTL clear, articulation 5, amplitude $C
RATE    = $00              ; speech rate $0 in D7:4 -- the chip's slowest
                           ; frame, 4096 x 16 / XCK = 36.6 ms, so each vowel
                           ; settles at its formant targets before the next
                           ; phoneme starts; I11/I2-I0 = 0
INFL    = $C9              ; I10-I3 for roughly a 90 Hz voice
FILT    = $D3              ; roughly a 20 KHz tract clock

; -- Zero page ---------------------------------------------------------------
IDX     = $06              ; index into the phoneme list
UNITS   = $07              ; frames left in the current phoneme


start
    ; Leave Power Down with the mode bits staged: write DR=11 while still
    ; down, then drop CTL. The one-to-zero transition latches the mode.
    lda #MODEDR
    sta SPHON
    lda #CTLUP
    sta SCTL
    lda #CTLDN
    sta SCTL

    ; Nominal speech attributes.
    lda #RATE
    sta SRATE
    lda #INFL
    sta SINF
    lda #FILT
    sta SFILT

say
    lda #$00
    sta IDX
next
    ldy IDX
    lda phonemes,y          ; next phoneme code, $FF = end of utterance
    cmp #$FF
    beq say                 ; wrap and speak it again, forever
    sta SPHON               ; start the phoneme
    jsr Hold                ; and let it have its full duration
    inc IDX
    bne next                ; unconditional (the list is far shorter than 256)


; Hold for the (4 - DR) frames the phoneme byte in A asked for. A frame at
; rate 0 is 4096 * 16 chip ticks, 36.6 ms, which is 37375 machine cycles; the
; 29 laps below come to 37120, deliberately a little short so the next phoneme
; reloads a chip that is still sounding rather than restarting a silent one.
Hold
    lsr a
    lsr a
    lsr a
    lsr a
    lsr a
    lsr a                   ; DR alone, 0 to 3
    sta UNITS
    lda #$04
    sec
    sbc UNITS
    sta UNITS               ; 4 - DR, so 1 to 4
h_unit
    ldx #$1D
h_lap
    ldy #$00
h_in
    dey
    bne h_in                ; 5 cycles a pass, 1280 a lap
    dex
    bne h_lap
    dec UNITS
    bne h_unit
    rts


; "CASSO ROCKS" as SSI 263A phonemes: K AE S O OU / R1 AH (closure) K S.
; Each byte carries its own DR duration in D7:6 (duration = frame x
; (4 - DR)): stops are bursts (DR=11, shortest) and get a short closure
; silence before them mid-word, fricatives and glides medium, vowels
; long, and the inter-repeat pause is a full-length silence. The "o" is
; O/OU (back rounded) -- :OH is the chip's front-rounded German vowel
; and reads as "io".
phonemes
    .byte $E9               ; K    k, DR=11 burst
    .byte $0C               ; AE   a as in "dad", DR=00 full vowel
    .byte $B0               ; S    s, DR=10
    .byte $51               ; O    o as in "store", DR=01
    .byte $92               ; OU   ou as in "boat", DR=10
    .byte $40               ; PA   word gap, DR=01
    .byte $9E               ; R1   r as in "rug", DR=10
    .byte $0E               ; AH   o as in "got", DR=00 full vowel
    .byte $C0               ; PA   stop closure, DR=11 short
    .byte $E9               ; K    k, DR=11 burst
    .byte $B0               ; S    s, DR=10
    .byte $00               ; PA   pause between repeats, DR=00 long
    .byte $00               ; PA
    .byte $FF               ; end marker

; --- end ---

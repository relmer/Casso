; ============================================================================
;  mockingboard-speech-demo.a65 -- what the Mockingboard C's voice chip can do
;
;  A direct-boot demo for the SSI 263A speech synthesizer in slot 4. It speaks,
;  changes voice type, asks a question with a rising pitch, delivers a line in
;  a flat computer monotone, and then sings.
;
;  The point of the singing is that it cannot be faked. An emulator that plays
;  pre-recorded phoneme samples can say the words; only one that synthesizes
;  from the chip's parameters can put those words on a melody, because pitch
;  is a register (the 12-bit inflection value) and not a property of a
;  recording.
;
;  Build:  scripts/BuildDirectBootDisk.ps1
;  Boot:   Casso.exe --machine Apple2e --disk1 Apple2\Demos\mockingboard-speech-demo.dsk
;
;  ---------------------------------------------------------------------------
;  Driving the chip
;
;  Speech and song are paced differently, on purpose.
;
;  SPOKEN lines are paced by this program's own cycle-counted delays. They do
;  NOT poll the chip's request line, because on a Mockingboard that cannot
;  work: the first 6522 decodes only A0-A3 and A7, so it answers everywhere in
;  $C400-$C47F, and $C440 is that VIA's port B. Every speech write lands in
;  both chips -- a phoneme byte to $C440 is also an ORB write, and the rate
;  byte to $C442 is also a DDRB write -- and a read returns the VIA's IRB, not
;  the voice chip, which drives nothing on a read. Polling D7 there reads back
;  the phoneme this program itself just wrote, through whichever port B bits
;  the rate byte last left as outputs. Reading A/R back is a Phasor native
;  mode facility; the Mockingboard route is A/R to VIA #1's CA1.
;
;  So the wait is computed instead of asked for. A phoneme sounds for
;  4096 * (16 - rate) * (4 - DR) chip ticks, and PhonemeWait counts out that
;  same product. Tempo becomes a property of this disk rather than of the host
;  clock, which is what a demo meant to be passed between emulators needs.
;
;  The phoneme is re-written once at the halfway point so the chip is still
;  sounding whichever rate its timer runs at, and so the next phoneme always
;  reloads a sounding chip rather than restarting a silent one -- no seam at
;  the boundary, the same trick Sing uses to hold a note.
;
;  SUNG notes cannot work that way. A single phoneme write sounds for at most
;  146 ms (4096 * 16 * 4 chip ticks at the slowest rate), which is shorter than
;  most notes, so a held note is built by re-writing the SAME phoneme byte
;  every delay unit until the note's duration is used up. Re-writing a phoneme
;  that is already sounding only reloads its duration countdown -- it does not
;  disturb the glottal phase, the resonators, or the amplitude envelope -- so
;  the note sustains without a seam. Note length therefore comes from this
;  program's own cycle-counted delay loop rather than from the chip's timer,
;  which also keeps the melody correct if the chip's phoneme timing is ever
;  recalibrated.
;
;  Pitch is the 12-bit inflection value, scattered across two registers:
;  I10-I3 fill $C441, I11 sits at bit 3 of $C442, and I2-I0 sit at bits 2-0.
;  $C442's high nibble is the speech rate, so both halves are written together
;  from a table rather than read back -- the chip is write-only through this
;  path, and a read returns only the request bit.
;
;  The tune sits two octaves below its usual key. Pitch is clamped at 400 Hz,
;  and a low fundamental leaves the formants legible, so the melody lands in
;  the same register as the speaking voice: it sounds like one voice that
;  starts singing rather than a second, higher instrument.
;
;  ---------------------------------------------------------------------------
;  Stream formats
;
;  Speech: one phoneme byte per sound, its duration in bits 7:6, terminated by
;  $FF. Five escapes carry the parameter changes:
;      $FB n ...   print n high-ASCII characters as a caption; n = 0 clears
;      $FC nn      nn delay units of silence
;      $FD hi lo   set pitch: hi to $C441, lo to $C442
;      $FE nn      set the filter frequency (voice type)
;      $FF         end of stream
;  Those five values would otherwise be phonemes $3B-$3F at the shortest
;  duration -- the German vowels and LB, none of which this demo speaks.
;
;  A pitch byte carries the speech rate in its high nibble, because $C442 holds
;  both. The generator folds the rate in; writing a bare pitch there resets the
;  chip to rate 0, which is what made the question run 1.6x slower than the
;  lines before it.
;
;  ---------------------------------------------------------------------------
;  Captions
;
;  Each word is preceded by a caption escape, so the text appears as the word
;  starts rather than after it finishes: Speak runs escapes to completion in the
;  gap between phonemes, which is the instant the word begins.
;
;  Text goes straight into the text page. The monitor's COUT is not usable from
;  a direct-boot payload -- it is a JMP through $0036, which nothing has set
;  when the boot ROM jumps here -- and COUT1, HOME and CROUT all depend on the
;  text window and cursor bytes being initialized. Writing $0400-$07FF costs
;  about 19 cycles per character and depends on nothing.
;
;  Song: four bytes per record -- phoneme, pitch high, pitch low, duration in
;  delay units -- terminated by $FF in the phoneme position. Consonants take a
;  unit or two and the vowel carries the rest of the note, all at one pitch.
; ============================================================================

    .org $6000

; -- SSI 263A, slot 4, speech socket 1 ---------------------------------------
SPHON   = $C440            ; DR duration in D7:6, phoneme in D5:0; reads D7 = request
SINF    = $C441            ; inflection I10-I3
SRATE   = $C442            ; rate in D7:4, I11 in D3, I2-I0 in D2:0
SCTL    = $C443            ; CTL in D7, articulation in D6:4, amplitude in D3:0
SFILT   = $C444            ; vocal tract filter clock

; -- Soft switches -----------------------------------------------------------
CLR80COL = $C000           ; 80STORE off
CLR80VID = $C00C           ; 40-column video
TXTCLR   = $C050           ; graphics, not text
MIXSET   = $C053           ; mixed: four text rows under the graphics
LOWSCR   = $C054           ; page 1
HIRES    = $C057           ; hi-res, not lo-res

; -- Attribute values --------------------------------------------------------
MODEDR  = $C0              ; DR=11 while still powered down: A/R active, phoneme timing
CTLUP   = $80              ; CTL set -- Power Down
CTLDN   = $5C              ; CTL clear, articulation 5, amplitude $C
FILTLO  = $B4              ; ~11.8 kHz tract clock -- a lower, heavier voice
FILTNOM = $D3              ; ~19.9 kHz -- the datasheet's nominal setting
FILTHI  = $E2              ; ~29.8 kHz -- a lighter, smaller voice
PHMASK  = $3F              ; the phoneme code within a phoneme byte
VOWELMAX = $1C             ; codes $01-$1C are the vowels, the syllable nuclei
DECAYU  = $08              ; spoken-path units between flash decay steps

; -- Stream escapes ----------------------------------------------------------
ESCCAP  = $FB
ESCWAIT = $FC
ESCPTCH = $FD
ESCFILT = $FE
ESCEND  = $FF

; -- Caption geometry --------------------------------------------------------
;  Hi-res mixed mode: HAL's eye fills the 160 graphics rows, and the four text
;  rows beneath it carry three caption rows and the title. Text row bases are
;  the Apple's interleaved layout: base = $400 + (row & 7) * $80 + (row >> 3) * 40.
CAPROWS = $03
TITLE   = $07D0            ; text row 23

; -- Zero page ---------------------------------------------------------------
PTR     = $06              ; stream pointer (2 bytes)
UNITS   = $08              ; delay-unit countdown
CURPH   = $09              ; phoneme byte being sustained
NDUR    = $0A              ; remaining units in the current note
CAPPTR  = $0B              ; current caption row base (2 bytes)
CAPCOL  = $0D              ; next column in that row
CAPROW  = $0E              ; which of the four caption rows
CAPLEN  = $0F              ; characters left to print
TMP     = $10
RATEC   = $11              ; 16 - the current speech rate, for the poll deadline
HALF    = $12              ; units left after the mid-phoneme reload
GLOWPH  = $13              ; how many flash bands are currently white, 0-3
DECAYT  = $14              ; units until the next decay step
EYEP    = $15              ; screen pointer for the eye (2 bytes)
SRCP    = $17              ; source pointer: image, then span lists (2 bytes)
TMP2    = $19
TMP3    = $1A
FLASHQ  = $1B              ; a vowel has been written; flash at the reload
RLROW   = $1C              ; unpacker: graphics row
RLCOL   = $1D              ; unpacker: byte column


start
    sei                         ; reset masks interrupts and nothing here
                                ; unmasks them; A/R reaches VIA #1's CA1 and
                                ; no handler stands behind $03FE

    jsr ScreenInit

    lda #$08                    ; a rate of 8, until a stream states its own
    sta RATEC

    ; Leave Power Down with the mode bits staged. Writing the duration bits
    ; while CTL is still set, then dropping CTL, is what latches the operating
    ; mode: A/R active, phoneme timing, transitioned inflection.
    lda #MODEDR
    sta SPHON
    lda #CTLUP
    sta SCTL
    lda #CTLDN
    sta SCTL

    lda #FILTNOM
    sta SFILT

    ; Rate and pitch both live in $C442 and both arrive from the streams, so
    ; there is nothing to set here. Leaving the inflection register alone would
    ; be a bug: it powers up at 0, which is 54.6 Hz -- a glottal period so long
    ; that a short phoneme spans barely two pulses and no vowel is resolvable.
    ; Every stream opens with a pitch escape for exactly that reason.

    ; ---- 1. HAL. A flat, deliberate line; the stream carries its own slower
    ;         rate in the high nibble of its opening pitch escape.
    lda #<halData
    ldx #>halData
    jsr Speak

    ; ---- 2. Joshua. A greeting that falls, then a question that rises
    ;         continuously under its final word.
    lda #<wargData
    ldx #>wargData
    jsr Speak

    ; ---- 3. A Centurion: the heavy tract, and a stream carrying its own low
    ;         pitch and slow rate.
    lda #FILTLO
    sta SFILT
    lda #<cylonData
    ldx #>cylonData
    jsr Speak
    lda #FILTNOM
    sta SFILT

    ; ---- 4. And then it sings.
    jsr Sing

    ; Silence the chip and stop. Power Down is the part's own quiescent state.
    lda #CTLUP
    sta SCTL
    jsr EyeRest
halt
    jmp halt


; ============================================================================
;  Speak -- play a phoneme stream, pacing on the chip's own request line
;
;  Entry: A = stream address low, X = stream address high
; ============================================================================
Speak
    sta PTR
    stx PTR+1

spk_next
    ldy #$00
    lda (PTR),y
    cmp #ESCEND
    beq spk_done
    cmp #ESCFILT
    beq spk_filt
    cmp #ESCPTCH
    beq spk_pitch
    cmp #ESCWAIT
    beq spk_wait
    cmp #ESCCAP
    beq spk_cap

    ; A plain phoneme: start it, step the pointer, then wait for the chip to
    ; ask for the next. The pointer advance happens BEFORE the poll so the
    ; answer to the request is as prompt as possible -- the chip stops sounding
    ; the moment its countdown expires, and every cycle spent before the next
    ; write is a cycle of decaying output.
    sta SPHON
    pha
    and #PHMASK                 ; a vowel is a syllable: queue a flash for it
    beq spk_novowel
    cmp #VOWELMAX+1
    bcs spk_novowel
    lda #$01
    sta FLASHQ
spk_novowel
    pla
    jsr PhonemeWait             ; A still holds the phoneme byte
    jsr Advance1
    jmp spk_next

spk_cap
    jsr Advance1
    jsr Caption
    jmp spk_next

spk_filt
    jsr Advance1
    ldy #$00
    lda (PTR),y
    sta SFILT
    jsr Advance1
    jmp spk_next

spk_pitch
    jsr Advance1
    ldy #$00
    lda (PTR),y                 ; I10-I3
    sta SINF
    jsr Advance1
    ldy #$00
    lda (PTR),y                 ; rate + I11 + I2-I0
    sta SRATE
    lsr a
    lsr a
    lsr a
    lsr a                       ; the rate nibble alone
    sta TMP
    lda #$10
    sec
    sbc TMP
    sta RATEC
    jsr Advance1
    jmp spk_next

spk_wait
    jsr Advance1
    ldy #$00
    lda (PTR),y
    jsr DelayUnits
    jsr Advance1
    jmp spk_next

spk_done
    rts


; ============================================================================
;  PhonemeWait -- hold for the length the phoneme's own DR bits asked for
;
;  A phoneme sounds for 4096 * (16 - rate) * (4 - DR) chip ticks. RATEC carries
;  16 - rate, refreshed by every pitch escape, and DR is D7:6 of the phoneme
;  byte, so the product is the length in units of 4096 ticks: 1 unit at the
;  fastest rate and shortest duration, 64 at the slowest and longest, which is
;  the 146 ms ceiling quoted at the top of this file.
;
;      DR = %11 -> 1 unit       DR = %01 -> 3 units
;      DR = %10 -> 2 units      DR = %00 -> 4 units
;
;  A unit here is 4096 machine cycles, matching what the chip's own countdown
;  spends on one, so the tempo is the one these streams were written against.
;
;  Halfway through, the phoneme is written again. That reloads a countdown that
;  is still running rather than restarting a chip that has fallen silent, which
;  keeps the line seamless whether the host's phoneme timer is fast or slow.
;
;  Entry: A = the phoneme byte, DR in D7:6.  Clobbers A, X, Y, TMP, UNITS,
;  HALF and CURPH -- none of which is live across a phoneme.
; ============================================================================
PhonemeWait
    sta CURPH                   ; kept for the reload halfway through

    lsr a
    lsr a
    lsr a
    lsr a
    lsr a
    lsr a                       ; DR alone, 0 to 3
    sta TMP
    lda #$04
    sec
    sbc TMP
    sta TMP                     ; 4 - DR, so 1 to 4

    lda #$00
pw_add
    clc
    adc RATEC
    dec TMP
    bne pw_add                  ; (16 - rate) * (4 - DR), 1 to 64

    sta TMP
    lsr a
    sta HALF                    ; the back half
    lda TMP
    sec
    sbc HALF
    sta UNITS                   ; the front half, never zero
    jsr BurnUnits

    ; The flash comes AFTER the reload. Painting three bands costs several
    ; thousand cycles, and the reload is what keeps a short phoneme sounding
    ; through the second half; it must not wait for the paint.
    lda HALF
    beq pw_tail
    sta UNITS
    lda CURPH
    sta SPHON                   ; reload the phoneme, still sounding
    jsr EyeFlashQ
    jmp BurnUnits
pw_tail
    jmp EyeFlashQ


; ============================================================================
;  BurnUnits -- spend UNITS units of 4096 machine cycles
;
;  The inner pass is bit-dey-bne, eight cycles, and 256 of them make 2048; two
;  laps make the unit. The bit is there only to spend three cycles on nothing,
;  and it reads TMP because TMP is dead by now.
; ============================================================================
BurnUnits
bu_unit
    ldy #$00
bu_in1
    bit TMP
    dey
    bne bu_in1                  ; 256 passes, 2048 cycles
    ldy #$E0
bu_in2
    bit TMP
    dey
    bne bu_in2                  ; 224 passes, 1792: the eye has the rest
    dec DECAYT
    bne bu_next
    lda #DECAYU
    sta DECAYT
    jsr EyeDecay
bu_next
    dec UNITS
    bne bu_unit
    rts


; ============================================================================
;  EyeFlash  -- a syllable: every flash band white at once
;  EyeFlashQ -- EyeFlash if a vowel has queued one
;  EyeDecay  -- one step of the flash collapsing inward: the outermost white
;               band back to orange
;  EyeRest   -- everything back to orange
;  PaintBand -- band X, orange (TMP2 = 0) or white (TMP2 = 1)
;
;  The bands are lists of row spans of whole bytes, so a paint is a tight run
;  of stores. Orange is the odd-x pixels of the orange/blue group, which makes
;  a solid orange byte $AA in an even byte column and $D5 in an odd one; the
;  fill starts from the column's parity and toggles. White is every pixel on.
; ============================================================================
EyeFlash
    lda #$00
    sta FLASHQ
    lda #$01
    sta TMP2
    ldx #$02
ef_loop
    jsr PaintBand
    dex
    bpl ef_loop
    lda #$03
    sta GLOWPH
    lda #DECAYU
    sta DECAYT
    rts

EyeFlashQ
    lda FLASHQ
    beq efq_done
    jmp EyeFlash
efq_done
    rts

EyeDecay
    lda GLOWPH
    beq ed_done
    dec GLOWPH
    ldx GLOWPH
    lda #$00
    sta TMP2
    jsr PaintBand
ed_done
    rts

EyeRest
    lda #$00
    sta FLASHQ
er_loop
    lda GLOWPH
    beq er_done
    jsr EyeDecay
    jmp er_loop
er_done
    rts

PaintBand
    lda glowBandLo,x
    sta SRCP
    lda glowBandHi,x
    sta SRCP+1
pb_span
    ldy #$00
    lda (SRCP),y                ; row, low
    sta EYEP
    iny
    lda (SRCP),y                ; row, high: zero ends the band
    beq pb_done
    sta EYEP+1
    iny
    lda (SRCP),y                ; first byte column
    sta TMP3
    iny
    lda (SRCP),y                ; byte count
    sta TMP
    lda SRCP
    clc
    adc #$04
    sta SRCP
    bcc pb_fill
    inc SRCP+1
pb_fill
    ldy TMP3
    lda TMP2
    bne pb_white
    tya
    and #$01
    beq pb_even
    lda #$D5
    bne pb_orange               ; always
pb_even
    lda #$AA
pb_orange
    sta (EYEP),y
    eor #$7F                    ; $AA <-> $D5
    iny
    dec TMP
    bne pb_orange
    beq pb_span                 ; always
pb_white
    lda #$FF
pb_wloop
    sta (EYEP),y
    iny
    dec TMP
    bne pb_wloop
    jmp pb_span
pb_done
    rts

glowBandLo
    .byte <glowBand0,<glowBand1,<glowBand2
glowBandHi
    .byte >glowBand0,>glowBand1,>glowBand2


; ============================================================================
;  Sing -- play the song stream
;
;  Each record holds a phoneme, a pitch, and a length in delay units. The
;  phoneme is re-written once per unit so the note sustains past the chip's
;  own duration limit; re-writing a sounding phoneme reloads its countdown and
;  nothing else, so the tone continues unbroken.
; ============================================================================
Sing
    lda #<songData
    sta PTR
    lda #>songData
    sta PTR+1

sng_next
    ldy #$00
    lda (PTR),y
    cmp #ESCEND
    beq sng_done
    cmp #ESCCAP                 ; tested before the record step, which is fixed-size
    bne sng_rec
    jsr Advance1
    jsr Caption
    jmp sng_next

sng_rec
    sta CURPH

    iny
    lda (PTR),y
    sta SINF                    ; I10-I3
    iny
    lda (PTR),y
    sta SRATE                   ; rate 0 + I11 + I2-I0
    iny
    lda (PTR),y
    sta NDUR

    ; Step over the four bytes of this record.
    lda PTR
    clc
    adc #$04
    sta PTR
    bcc sng_hold
    inc PTR+1

    ; A new note: if it is a vowel, it is a syllable, and the eye flashes.
    lda CURPH
    and #PHMASK
    beq sng_hold
    cmp #VOWELMAX+1
    bcs sng_hold
    jsr EyeFlash

sng_hold
    lda CURPH
    sta SPHON                   ; (re)start the phoneme; sustains if already sounding
    jsr Delay1
    jsr EyeDecay
    dec NDUR
    bne sng_hold
    jmp sng_next

sng_done
    rts


; ============================================================================
;  Advance1 -- step the stream pointer one byte
; ============================================================================
Advance1
    inc PTR
    bne adv_done
    inc PTR+1
adv_done
    rts


; ============================================================================
;  DelayUnits -- burn A delay units (A = 0 does nothing)
;  Delay1     -- burn one unit, about 41 ms of emulated time
;
;  The unit is this program's own clock. Note length is measured in these, not
;  in chip frames, so the melody keeps its tempo regardless of how the chip's
;  phoneme timer is calibrated.
; ============================================================================
DelayUnits
    cmp #$00
    beq del_done
    sta UNITS
    jsr EyeRest                 ; nothing is being said
del_loop
    jsr Delay1
    dec UNITS
    bne del_loop
del_done
    rts

Delay1
    ldx #$21                    ; 33 * 256 inner iterations, ~5 cycles each
d1_outer
    ldy #$00
d1_inner
    dey
    bne d1_inner
    dex
    bne d1_outer
    rts


; ============================================================================
;  ScreenInit -- 40-column text page 1, cleared, with the title in place
;
;  Nothing here calls the monitor. A direct-boot payload is entered by the
;  disk ROM with the zero-page vectors COUT and its relatives depend on still
;  holding power-on garbage, so the screen is set up from the soft switches
;  and filled by hand.
; ============================================================================
ScreenInit
    sta CLR80COL
    sta CLR80VID
    bit TXTCLR
    bit MIXSET
    bit LOWSCR
    bit HIRES

    ; Fill the text page with spaces: rows 20-23 show under the picture.
    lda #$A0
    ldx #$00
si_fill
    sta $0400,x
    sta $0500,x
    sta $0600,x
    sta $0700,x
    inx
    bne si_fill

    ; HAL's eye, unpacked from (count, byte) pairs across the 160 rows of the
    ; mixed-mode picture. A count with bit 7 set is an ALTERNATING run -- the
    ; byte and then its $7F complement, turn about -- which is how a solid
    ; orange fill packs, since orange is $AA in one byte column and $D5 in the
    ; next. The rows are not contiguous in memory, so the column is counted
    ; and the row pointer re-fetched at each row's end.
    lda #<eyeRle
    sta SRCP
    lda #>eyeRle
    sta SRCP+1
    lda #$00
    sta RLROW
    sta RLCOL
    jsr RleRow
rl_pair
    ldy #$00
    lda (SRCP),y                ; count: zero ends the picture
    beq rl_done
    sta TMP3                    ; bit 7 kept: alternate or not
    and #$7F
    sta TMP
    iny
    lda (SRCP),y                ; the byte
    sta TMP2
    lda SRCP
    clc
    adc #$02
    sta SRCP
    bcc rl_run
    inc SRCP+1
rl_run
    ldy RLCOL
    lda TMP2
    sta (EYEP),y
    bit TMP3
    bpl rl_noalt
    eor #$7F
    sta TMP2
rl_noalt
    iny
    cpy #40
    bne rl_same
    ldy #$00
    inc RLROW
    jsr RleRow
rl_same
    sty RLCOL
    dec TMP
    bne rl_run
    beq rl_pair                 ; always
rl_done

    ; Title on the bottom row, then park the caption cursor at the first
    ; caption row. The picture starts with every band orange: at rest.
    ldy #$00
si_title
    lda titleText,y
    beq si_capinit
    sta TITLE+8,y
    iny
    bne si_title

si_capinit
    lda #$00
    sta CAPROW
    sta GLOWPH
    sta FLASHQ
    lda #DECAYU
    sta DECAYT
    jsr CaptionRow
    rts

RleRow
    ldx RLROW
    cpx #160
    bcs rr_done                 ; the last run ends exactly on row 160
    lda hgrRowLo,x
    sta EYEP
    lda hgrRowHi,x
    sta EYEP+1
rr_done
    rts


; ============================================================================
;  Caption -- print the escape's text, or clear the caption area
;
;  Entry: PTR points at the length byte. A length of zero clears and resets.
;  Words are separated by a space, and a word that will not fit on the current
;  row starts the next one, so a caption never wraps mid-word.
; ============================================================================
Caption
    ldy #$00
    lda (PTR),y
    sta CAPLEN
    jsr Advance1
    lda CAPLEN
    bne cap_fit

    ; Length 0: blank the four caption rows and start again at the top.
    lda #$00
    sta CAPROW
cap_clr
    jsr CaptionRow
    lda #$A0
    ldy #39
cap_clr1
    sta (CAPPTR),y
    dey
    bpl cap_clr1
    inc CAPROW
    lda CAPROW
    cmp #CAPROWS
    bne cap_clr
    lda #$00
    sta CAPROW
    jsr CaptionRow
    rts

cap_fit
    ; Does the word (plus a leading space when mid-row) fit in 40 columns?
    lda CAPCOL
    beq cap_nospace
    clc
    adc #$01                    ; the separating space
    sta TMP
    clc
    adc CAPLEN
    cmp #41
    bcc cap_space
    jsr CaptionNext             ; start a fresh row instead of splitting a word
    jmp cap_nospace

cap_space
    ldy CAPCOL
    lda #$A0
    sta (CAPPTR),y
    lda TMP
    sta CAPCOL

cap_nospace
    ldy #$00
cap_put
    cpy CAPLEN
    beq cap_done
    lda (PTR),y
    sty TMP
    ldy CAPCOL
    sta (CAPPTR),y
    inc CAPCOL
    ldy TMP
    iny
    bne cap_put

cap_done
    ; Step the stream pointer past the characters just printed.
    lda CAPLEN
    clc
    adc PTR
    sta PTR
    bcc cap_ret
    inc PTR+1
cap_ret
    rts


; ============================================================================
;  CaptionNext -- move to the next caption row, wrapping to the first
;  CaptionRow -- point CAPPTR at row CAPROW and reset the column
; ============================================================================
CaptionNext
    inc CAPROW
    lda CAPROW
    cmp #CAPROWS
    bcc CaptionRow
    lda #$00
    sta CAPROW

CaptionRow
    ldx CAPROW
    lda capRowLo,x
    sta CAPPTR
    lda capRowHi,x
    sta CAPPTR+1
    lda #$00
    sta CAPCOL
    ; Blank the row we are about to write into.
    lda #$A0
    ldy #39
cr_blank
    sta (CAPPTR),y
    dey
    bpl cr_blank
    rts


; Text rows 20-22 on page 1, the three above the title.
capRowLo
    .byte $50,$D0,$50
capRowHi
    .byte $06,$06,$07

titleText
    .byte $CD,$CF,$C3,$CB,$C9,$CE,$C7,$C2,$CF,$C1,$D2,$C4,$A0
    .byte $D3,$D0,$C5,$C5,$C3,$C8,$A0,$C3,$C8,$C9,$D0
    .byte $00


; ============================================================================
;  Data
; ============================================================================
    .include "mockingboard-speech-demo.inc"

; --- end ---
